# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sakhi_health?schema=public"

# Authentication Secret
JWT_SECRET="sakhi-health-super-secure-jwt-secret-key-change-in-production-2025"

# Google Gemini API
# If left blank or invalid, Sakhi Health automatically engages the clinical rule-based engine
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

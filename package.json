{
  "name": "sakhi-health",
  "version": "1.0.0",
  "description": "Sakhi Health — Women's Health Symptom Understanding & PCOS Guidance",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
